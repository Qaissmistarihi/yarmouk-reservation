{
  "name": "yarmouk-reservation-backend-low",
  "version": "1.0.0",
  "description": "Backend for Yarmouk University Room Reservation System - Low Resource Version",
  "main": "src/server.js",
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=2048 && nodemon src/server.js",
    "dev-low": "set NODE_OPTIONS=--max-old-space-size=1536 && nodemon src/server.js",
    "start": "set NODE_OPTIONS=--max-old-space-size=2048 && node src/server.js",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.0"
  },
  "keywords": ["yarmouk", "reservation", "university"],
  "author": "Yarmouk University",
  "license": "MIT"
}
