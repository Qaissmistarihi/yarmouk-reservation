# Database connection string (MySQL)
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT secret key (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Server port (default: 5000)
PORT=5000

# Allowed frontend origin(s), comma-separated (e.g. Vercel URL + localhost for local dev)
# Example: https://yarmouk-reservation.vercel.app,http://localhost:3000
FRONTEND_URL=https://yarmouk-reservation.vercel.app
